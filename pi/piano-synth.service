[Unit]
Description=FluidSynth: piano + mechanics soundfonts
After=sound.target
# the udev rule restarts this service when a USB sound card is plugged in or removed
StartLimitIntervalSec=0

[Service]
User=root
EnvironmentFile=/etc/piano-synth.conf
# The script picks the audio output (ALSA_DEVICE=auto) and starts FluidSynth with -is (no interactive shell + server
# mode; without -s FluidSynth exits right after loading).
ExecStart=/opt/piano-synth/piano-synth-run
LimitRTPRIO=95
LimitMEMLOCK=infinity
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
