#!/bin/bash
# Установка звуковых банков без пакета piano-synth-soundfonts (быстрее для файлов в сотни мегабайт).
#
#   sudo piano-synth-install-banks --piano piano.sf2 --mech mech.sf2 [--device hw:1] [--gain 1.0]
set -euo pipefail

CONF=/etc/piano-synth.conf
DEST=/opt/piano-synth/soundfonts
PIANO="" MECH="" DEVICE="" GAIN=""

usage() { sed -n '2,4p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-0}"; }

while [ $# -gt 0 ]; do
  case "$1" in
    --piano)  PIANO="$2";  shift 2 ;;
    --mech)   MECH="$2";   shift 2 ;;
    --device) DEVICE="$2"; shift 2 ;;
    --gain)   GAIN="$2";   shift 2 ;;
    -h|--help) usage 0 ;;
    *) echo "Неизвестный параметр: $1"; usage 1 ;;
  esac
done

[ "$(id -u)" = 0 ] || { echo "Запустите от root (sudo)."; exit 1; }
if [ -n "$PIANO" ] && [ ! -f "$PIANO" ]; then echo "Нет файла: $PIANO"; exit 1; fi
if [ -n "$MECH" ] && [ ! -f "$MECH" ]; then echo "Нет файла: $MECH"; exit 1; fi
[ -n "$PIANO$MECH$DEVICE$GAIN" ] || usage 1

set_conf() {  # KEY VALUE
  if grep -q "^$1=" "$CONF"; then sed -i "s|^$1=.*|$1=$2|" "$CONF"; else echo "$1=$2" >> "$CONF"; fi
}

install -d "$DEST"
if [ -n "$PIANO" ]; then install -m 644 "$PIANO" "$DEST/piano.sf2"; set_conf PIANO_SF2 "$DEST/piano.sf2"; fi
if [ -n "$MECH" ];  then install -m 644 "$MECH"  "$DEST/mech.sf2";  set_conf MECH_SF2  "$DEST/mech.sf2";  fi
[ -n "$DEVICE" ] && set_conf ALSA_DEVICE "$DEVICE"
[ -n "$GAIN" ]   && set_conf GAIN "$GAIN"

if [ -f "$DEST/piano.sf2" ] && [ -f "$DEST/mech.sf2" ]; then
  systemctl restart piano-synth piano-fx
  echo "Готово. Загрузка банков занимает десятки секунд."
else
  echo "Сохранено. Для запуска нужны оба файла (piano.sf2 и mech.sf2)."
fi
